# ─── App ────────────────────────────────────────────────
# URL pública do app (usada nos links de convite e nos e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Somente no servidor (cron do relatório, tarefas administrativas). NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# ─── E-mail (Resend) ────────────────────────────────────
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: "BoraTreinar <relatorios@seudominio.com.br>"
EMAIL_FROM=

# ─── IA para sugestões do relatório semanal (opcional) ──
# As regras simples sempre aparecem; cada IA configurada aparece ao lado, para comparar.
# Gemini (Google AI Studio, tem faixa gratuita): https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Claude (Anthropic, pago por uso): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Cron ───────────────────────────────────────────────
# Segredo que a Vercel envia no header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=gere-um-valor-aleatorio-longo

# Notificações push (Web Push): funcionam sem configuração (chaves derivadas da service role).
# Opcional: NEXT_PUBLIC_VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY próprias (npx web-push generate-vapid-keys).

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/supabase/server": [
        "./src/lib/supabase.ts"
      ],
      "@/lib/supabase/client": [
        "./src/lib/supabase.ts"
      ],
      "@/*": [
        "../src/*"
      ],
      "~/*": [
        "./src/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

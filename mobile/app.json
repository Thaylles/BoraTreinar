{
  "expo": {
    "name": "BoraTreinar",
    "slug": "boratreinar",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.boratreinar.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-video",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "color": "#009c3b",
          "defaultChannel": "geral"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O BoraTreinar usa a câmera para fotos de perfil, de exercícios e da liberação médica.",
          "photosPermission": "O BoraTreinar usa suas fotos para foto de perfil, de exercícios e da liberação médica."
        }
      ]
    ],
    "scheme": "boratreinar"
  }
}
